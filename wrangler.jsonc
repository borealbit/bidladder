{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidladder",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bidladder",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "88273001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "88273002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "STRIPE_INTEGRATION_IDENTIFIER": "bidladder-rkqjvmpx"
  },
  "secrets": {
    "required": ["ADMIN_API_KEY_HASH", "STRIPE_API_KEY", "STRIPE_WEBHOOK_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "upload_source_maps": true
}
