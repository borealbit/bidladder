# Generate a key and its SHA-256 hash with:
# node scripts/generate-admin-key.mjs
ADMIN_API_KEY_HASH=replace-with-a-64-character-sha256-hash

# Prefer a restricted Stripe API key with only the permissions documented in
# docs/DEPLOYMENT.md. Keep test and live mode secrets in separate deployments.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
